# Non-secret local overrides. Copy to backend/.env
# Prefer AWS credentials from the shell / SSO / IAM role — never put access keys here.

AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# In-process job worker for local development (deployed envs use Lambda + Scheduler)
LOCAL_WORKER=true

# Optional: if you are not using infra/cdk-outputs.json, set these explicitly:
# USER_POOL_ID=
# USER_POOL_CLIENT_ID=
# DATA_KEY_ARN=
# KNOWLEDGE_BUCKET=
# UPLOADS_BUCKET=
# EXPORTS_BUCKET=
# COMMUNITY_BUCKET=
# SYLLABI_TABLE=
# ANALYSES_TABLE=
# SOURCES_TABLE=
# COMMUNITY_TABLE=
# FEEDBACK_TABLE=
# AUDIT_TABLE=
# KNOWLEDGE_BASE_ID=
# KNOWLEDGE_DATA_SOURCE_ID=
# GUARDRAIL_ID=
# GUARDRAIL_VERSION=DRAFT
