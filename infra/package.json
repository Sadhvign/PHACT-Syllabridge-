{
  "name": "phact-infra",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "tsc --noEmit",
    "cdk": "cdk",
    "synth": "cdk synth --quiet",
    "deploy": "cdk deploy --all --require-approval never --outputs-file cdk-outputs.json && node scripts/write-frontend-env.mjs",
    "outputs": "node scripts/write-frontend-env.mjs"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.220.0",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "aws-cdk": "^2.1030.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
