# Copy to frontend/.env.local (or run: cd infra && npm run outputs)
# These Cognito values are public client identifiers — still do not commit real .env.local.

VITE_AWS_REGION=us-east-1
VITE_USER_POOL_ID=
VITE_USER_POOL_CLIENT_ID=

# Leave empty for local Vite proxy to http://localhost:8000
# Set to the deployed API base URL in production (no trailing slash)
VITE_API_BASE_URL=
